{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ESP32: build prober",
            "type": "shell",
            "command": ". C:\esp\esp-idf\export.ps1; idf.py build",
            "options": {
                "cwd": "${workspaceFolder}/prober",
                "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] }
            },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true }
        }
    ]
}
