{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ESP32: syntax-check prober",
            "type": "process",
            "command": "${workspaceFolder}/third_party/toolchain/xtensa-esp-elf/bin/xtensa-esp32-elf-g++.exe",
            "args": [
                "-std=gnu++2b",
                "-fsyntax-only",
                "-I${workspaceFolder}/prober",
                "-I${workspaceFolder}/third_party/esp-idf-config",
                "-I${workspaceFolder}/third_party/esp-idf/components/esp_wifi/include",
                "-I${workspaceFolder}/third_party/esp-idf/components/esp_common/include",
                "-I${workspaceFolder}/third_party/esp-idf/components/esp_event/include",
                "-I${workspaceFolder}/third_party/esp-idf/components/esp_hw_support/include",
                "-I${workspaceFolder}/third_party/esp-idf/components/freertos/FreeRTOS-Kernel/include",
                "-I${workspaceFolder}/third_party/esp-idf/components/freertos/config/include/freertos",
                "-I${workspaceFolder}/third_party/esp-idf/components/freertos/config/xtensa/include",
                "-I${workspaceFolder}/third_party/esp-idf/components/xtensa/include",
                "-I${workspaceFolder}/third_party/esp-idf/components/xtensa/esp32/include",
                "-I${workspaceFolder}/third_party/esp-idf/components/freertos/FreeRTOS-Kernel/portable/xtensa/include/freertos",
                "-I${workspaceFolder}/third_party/esp-idf/components/soc/esp32/include",
                "-I${workspaceFolder}/third_party/esp-idf/components/esp_system/include",
                "-I${workspaceFolder}/third_party/esp-idf/components/newlib/platform_include",
                "-I${workspaceFolder}/third_party/esp-idf/components/heap/include",
                "-I${workspaceFolder}/third_party/esp-idf/components/esp_rom/include",
                "-I${workspaceFolder}/third_party/esp-idf/components/esp_netif/include",
                "-I${workspaceFolder}/third_party/esp-idf/components/esp_wifi/include/local",
                "${workspaceFolder}/prober/probe.cpp",
                "${workspaceFolder}/prober/main.cpp"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}